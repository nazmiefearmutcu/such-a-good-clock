{
  "name": "such-a-good-clock",
  "version": "2.0.0",
  "description": "Next-gen themed fullscreen clock: 11 cinematic themes, analog/flip/digital faces, alarms, countdown timer, pomodoro, stopwatch, world clock, ambient audio. PWA + native macOS/Windows/Linux desktop.",
  "type": "module",
  "main": "desktop/main.cjs",
  "author": {
    "name": "Nazmi Efe Armutcu",
    "email": "nazmiefearmutcu@users.noreply.github.com"
  },
  "homepage": "https://nazmiefearmutcu.github.io/such-a-good-clock/",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview --port 4173",
    "test:e2e": "vite build && ROOT=dist node scripts/e2e.mjs",
    "desktop:run": "vite build && electron .",
    "desktop:build": "vite build && electron-builder --publish never",
    "desktop:build:dir": "vite build && electron-builder --dir --publish never",
    "desktop:build:mac": "vite build && electron-builder --mac --publish never",
    "desktop:build:win": "vite build && electron-builder --win --publish never",
    "desktop:build:linux": "vite build && electron-builder --linux --publish never"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "electron": "^42.3.2",
    "electron-builder": "^26.8.1",
    "vite": "^8.0.16"
  },
  "build": {
    "appId": "com.nazmiefearmutcu.such-a-good-clock",
    "productName": "Such A Good Clock",
    "asar": true,
    "directories": {
      "output": "dist-native"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "icons/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "icons/such-a-good-clock.icns",
      "identity": null,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "icons/such-a-good-clock.ico",
      "target": [
        "nsis",
        "portable",
        "zip"
      ]
    },
    "nsis": {
      "allowToChangeInstallationDirectory": true,
      "oneClick": false,
      "perMachine": false
    },
    "linux": {
      "category": "Utility",
      "icon": "icons",
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ]
    }
  }
}
